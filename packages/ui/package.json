{
  "name": "@fer-oshiro/ui",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "prebuild": "npm run css:build",
    "build": "tsup src/index.tsx --format esm,cjs --dts --external react",
    "dev": "npm run css:watch & tsup src/index.tsx --format esm,cjs --dts --watch",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "css:build": "tailwindcss -i ./src/styles.css -o ./styles.css --minify",
    "css:watch": "tailwindcss -i ./src/styles.css -o ./styles.css --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@fer-oshiro/eslint-config": "*",
    "@fer-oshiro/typescript-config": "*",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "eslint": "^10.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ark-ui/react": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
