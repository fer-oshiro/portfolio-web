{
  "name": "portfolio-web",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev:back": "tsx watch scripts/local-server.ts",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "commitizen": "^4.2.4",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": "24.13.1"
  },
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
