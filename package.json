{
  "name": "portfolio-web",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev:back": "tsx watch scripts/local-server.ts",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "clean:node-modules": "find . -name node_modules -type d -prune -exec rm -rf '{}' +",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.13.1"
  },
  "packageManager": "npm@11.8.0",
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.59.0",
    "@rollup/rollup-darwin-x64": "4.59.0",
    "@rollup/rollup-linux-arm-gnueabihf": "4.59.0",
    "@rollup/rollup-linux-arm64-gnu": "4.59.0",
    "@rollup/rollup-linux-x64-gnu": "4.59.0",
    "@swc/core-darwin-arm64": "^1.15.46",
    "@swc/core-darwin-x64": "^1.15.46",
    "@swc/core-linux-arm-gnueabihf": "^1.15.46",
    "@swc/core-linux-arm64-gnu": "^1.15.46",
    "@swc/core-linux-x64-gnu": "^1.15.46"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
