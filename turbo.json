{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["BUCKET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "storybook-static/**"
      ]
    },
    "@fer-oshiro/home#build": {
      "dependsOn": ["^build"],
      "env": ["WEBSOCKET_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@fer-oshiro/home#dev": {
      "cache": false,
      "dependsOn": ["@fer-oshiro/ui#build"],
      "env": ["WEBSOCKET_URL"],
      "persistent": true,
      "with": ["@fer-oshiro/ui#dev:js", "@fer-oshiro/ui#css:watch"]
    },
    "@fer-oshiro/ui#dev:js": {
      "cache": false,
      "persistent": true
    },
    "@fer-oshiro/ui#css:watch": {
      "cache": false,
      "persistent": true
    },
    "@fer-oshiro/realtime#dev": {
      "cache": false,
      "persistent": true,
      "env": ["PORT", "REALTIME_HOST"],
      "passThroughEnv": ["GROQ_API_KEY"]
    }
  }
}
