{
  "name": "@fer-oshiro/realtime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run clean && npm run build:signaling && npm run build:chat && npm run build:drawing",
    "build:signaling": "npm run bundle:signaling && npm run zip:signaling",
    "build:chat": "npm run bundle:chat && npm run zip:chat",
    "build:drawing": "npm run bundle:drawing && npm run zip:drawing",
    "bundle:signaling": "esbuild src/entrypoints/aws/signaling.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/aws/signaling/index.js",
    "bundle:chat": "esbuild src/entrypoints/aws/chat.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/aws/chat/index.js",
    "bundle:drawing": "esbuild src/entrypoints/aws/drawing.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/aws/drawing/index.js",
    "zip:signaling": "zip -q -FS -j dist/aws/signaling.zip dist/aws/signaling/index.js",
    "zip:chat": "zip -q -FS -j dist/aws/chat.zip dist/aws/chat/index.js",
    "zip:drawing": "zip -q -FS -j dist/aws/drawing.zip dist/aws/drawing/index.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint . --config ../../../eslint.config.mjs",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/lib-dynamodb": "^3.1026.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "@fer-oshiro/realtime-contract": "*",
    "dotenv": "^14.3.2",
    "openai": "^7.0.0",
    "twilio": "^6.0.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@fer-oshiro/typescript-config": "*",
    "@types/aws-lambda": "^8.10.131",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "type": "commonjs"
}
