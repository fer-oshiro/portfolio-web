{
  "name": "@fer-oshiro/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run clean && npm run build:authorizer && npm run build:signaling && npm run build:chat && npm run build:drawing && npm run build:cost-guard",
    "dev": "tsx watch src/entrypoints/local.ts",
    "build:authorizer": "npm run bundle:authorizer && npm run zip:authorizer",
    "build:signaling": "npm run bundle:signaling && npm run zip:signaling",
    "build:chat": "npm run bundle:chat && npm run zip:chat",
    "build:drawing": "npm run bundle:drawing && npm run zip:drawing",
    "build:cost-guard": "npm run bundle:cost-guard && npm run zip:cost-guard",
    "bundle:authorizer": "esbuild src/entrypoints/aws/authorizer.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/aws/authorizer/index.js",
    "bundle:signaling": "esbuild src/entrypoints/aws/signaling.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/aws/signaling/index.js",
    "bundle:chat": "esbuild src/entrypoints/aws/chat.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/aws/chat/index.js",
    "bundle:drawing": "esbuild src/entrypoints/aws/drawing.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/aws/drawing/index.js",
    "bundle:cost-guard": "esbuild src/entrypoints/aws/cost-guard.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/aws/cost-guard/index.js",
    "zip:authorizer": "zip -q -FS -j dist/aws/authorizer.zip dist/aws/authorizer/index.js",
    "zip:signaling": "zip -q -FS -j dist/aws/signaling.zip dist/aws/signaling/index.js",
    "zip:chat": "zip -q -FS -j dist/aws/chat.zip dist/aws/chat/index.js",
    "zip:drawing": "zip -q -FS -j dist/aws/drawing.zip dist/aws/drawing/index.js",
    "zip:cost-guard": "zip -q -FS -j dist/aws/cost-guard.zip dist/aws/cost-guard/index.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint . --config ../../eslint.config.mjs",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/client-sns": "^3.1037.0",
    "@aws-sdk/lib-dynamodb": "^3.1026.0",
    "@aws-sdk/s3-presigned-post": "^3.1107.0",
    "@fer-oshiro/realtime-contract": "*",
    "dotenv": "^14.3.2",
    "openai": "^7.0.0",
    "twilio": "^6.0.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@fer-oshiro/typescript-config": "*",
    "@types/aws-lambda": "^8.10.131",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "type": "commonjs"
}
